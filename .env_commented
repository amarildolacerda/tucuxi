# === Tucuxi — Configuração comentada ===
# Espelho de .env_default com comentários para auxiliar na configuração.
# Copie para .env e preencha os valores sensíveis.
# cp .env_commented .env

# ── Predictor MVP ──
# Habilita o preditor Tucuxi (MVP). true|false
PREDICTOR_ENABLED=true
# Janela (em dias) de histórico usada pelo preditor.
PREDICTOR_HISTORY_DAYS=7
# Intervalo (segundos) entre execuções do preditor.
PREDICTOR_INTERVAL_SECONDS=900
# Limiar de confiança para predição válida (0.0 a 1.0).
PREDICTION_THRESHOLD=0.75
# Cooldown (segundos) entre disparos de dissuasão do preditor.
PREDICTOR_DETER_COOLDOWN_SEC=900
# Mapa de entidades (JSON) da integração do preditor. Vazio = desabilitado.
PREDICTOR_ENTITY_MAP=

# ── Servidor ──
# Endereço de escuta do servidor web (0.0.0.0 = todas as interfaces).
SERVER_HOST=0.0.0.0
# Porta TCP do servidor web.
SERVER_PORT=8000

# ── Detector (YOLO) ──
# Caminho do modelo ONNX do detector (dentro do container, /app/data/...).
DETECTOR_MODEL_PATH=/app/data/models/detector.onnx
# Confiança mínima para aceitar uma detecção (0.0 a 1.0; maior = menos detecções).
DETECTOR_CONFIDENCE=0.30
# IoU de NMS: menor = descarta mais detecções sobrepostas (0.0 a 1.0).
DETECTOR_IOU=0.35

# ── Motion detection ──
# Área mínima (px) de diferença para marcar movimento. Menor = mais sensível.
MOTION_MIN_AREA=6000
# Frames consecutivos de movimento para manter o evento ativo. Menor = mais sensível.
MOTION_PERSIST_FRAMES=3
# Razão espacial para filtrar ruído/chuva do movimento (0.0 a 1.0).
RAIN_SPATIAL_RATIO=0.35
# Espera entre frames na captura (segundos). Menor = mais processamento.
FRAME_WAIT_SECONDS=0.1
# Tempo sem frame válido para considerar a câmera não-saudável (segundos).
WORKER_HEALTHY_TIMEOUT=15

# ── Telegram ──
# Token do bot Telegram (envio de alertas). Vazio = desabilitado.
TELEGRAM_BOT_TOKEN=SEU_TOKEN_AQUI
# Chat ID de destino das notificações.
TELEGRAM_CHAT_ID=SEU_CHAT_ID_AQUI

# ── MQTT / Home Assistant ──
# Endereço do broker MQTT (ex: Home Assistant).
MQTT_BROKER_URL=192.168.1.12
# Porta do broker MQTT.
MQTT_BROKER_PORT=1883
# Usuário de autenticação do MQTT.
MQTT_USERNAME=SEU_USERNAME_AQUI
# Senha de autenticação do MQTT.
MQTT_PASSWORD=SUA_SENHA_AQUI
# Tópico MQTT onde os alertas são publicados.
MQTT_TOPIC=homeassistant/security/alert
# URL da instância do Home Assistant.
HOME_ASSISTANT_URL=http://192.168.1.12:8123
# Token de acesso (long-lived) do Home Assistant.
HOME_ASSISTANT_TOKEN=SEU_TOKEN_HA_AQUI
# Tipo de evento disparado no Home Assistant.
HOME_ASSISTANT_EVENT_TYPE=security_alert

# ── Sirene / atuação externa ──
# Tópico MQTT usado para acionar a sirene/automação.
SIREN_MQTT_TOPIC=secur/automation/siren
# Tipos de evento que acionam a sirene (lista separada por vírgula).
SIREN_EVENT_TYPES=intruder_detected,fall_detected,loitering,direction_change,unknown_detected

# ── Alertas / cooldowns ──
# Envia alerta "sem movimento" após este período sem ocorrências (segundos).
NO_MOTION_ALERT_SECONDS=60
# Cooldown geral: suprime eventos repetidos do mesmo tipo neste intervalo (segundos).
ALERT_COOLDOWN_SECONDS=60
# Cooldown para o tipo 'intruder_detected' (segundos).
ALERT_COOLDOWN_INTRUDER=30
# Cooldown para o tipo 'unknown_detected' (segundos).
ALERT_COOLDOWN_UNKNOWN=30
# Cooldown para o tipo 'loitering' (segundos).
ALERT_COOLDOWN_LOITERING=300
# Cooldown para o tipo 'direction_change' (segundos).
ALERT_COOLDOWN_DIRECTION=60
# Cooldown para o tipo 'fall_detected' (segundos).
ALERT_COOLDOWN_FALL=30

# ── Tracking / comportamento ──
# IoU mínimo para associar detecções ao mesmo objeto (0.0 a 1.0).
TRACK_IOU_THRESHOLD=0.3
# Idade máxima (segundos) de um objeto sem associação antes de descartar.
TRACK_MAX_AGE_SECONDS=2.0
# Tempo (segundos) de permanência na mesma área para classificar 'loitering'.
LOITERING_SECONDS=30
# Distância máxima (px) entre posições para manter o mesmo objeto.
LOITERING_MAX_DISTANCE=80
# Razão de aspecto mínima (altura/largura) para classificar queda.
FALL_ASPECT_RATIO=1.2

# ── Thumbnails ──
# Intervalo (segundos) entre geração de thumbnails.
THUMBNAIL_INTERVAL_SECONDS=20
# Diferença média por pixel (0-255) acima da qual grava novo thumbnail (dedup).
THUMBNAIL_DIFF_THRESHOLD=3.0
# Quantidade de thumbnails mantidas no histórico.
THUMBNAIL_HISTORY_SIZE=30
# Janela de deduplicação por cena estável (segundos).
EVENT_DEDUP_WINDOW_SECONDS=300

# ── Clips ──
# Segundos de gravação ANTES do evento (buffer).
CLIP_PRE_SECONDS=10
# Segundos de gravação DEPOIS do evento.
CLIP_POST_SECONDS=10
# FPS de gravação dos clipes.
CLIP_FPS=5
# Quantidade de clipes mantidos no histórico.
CLIP_HISTORY_SIZE=20

# ── Identity ──
# Habilita o reconhecimento de identidade (rosto/reid). true|false
IDENTITY_ENABLED=false
# Caminho do modelo de embedding facial.
IDENTITY_FACE_MODEL_PATH=
# Caminho do modelo de re-identificação (ReID).
IDENTITY_REID_MODEL_PATH=
# Limiar de similaridade para considerar a mesma identidade (0.0 a 1.0).
IDENTITY_MATCH_THRESHOLD=0.6

# ── Privacidade ──
# Modo privacidade: desativa recursos que expõem pessoas/rostos. true|false
PRIVACY_MODE=false

# ── Auth / Sessão ──
# Tempo de vida da sessão web (horas).
SESSION_TTL_HOURS=24
# Máximo de tentativas de login antes de bloquear.
MAX_LOGIN_ATTEMPTS=5
# Tempo de bloqueio após falhas de login (minutos).
LOCKOUT_MINUTES=5

# ── Retenção de eventos ──
# Liga/desliga a poda automática de eventos por tipo. true|false
EVENT_PRUNE_ENABLED=true
# Intervalo da rotina de poda (segundos).
EVENT_PRUNE_INTERVAL_SECONDS=30
# Limite de eventos retornados por listagem.
EVENT_LIST_LIMIT=50
# Retenção (dias) por tipo de evento. Comentados = usa o default do código.
# 0 = remove imediatamente; -1 = nunca podar por tipo.
#EVENT_PRUNE_MOTION_DETECTED_DAYS=1
#EVENT_PRUNE_CAPTURE_DAYS=7
#EVENT_PRUNE_SNAPSHOT_INFO_DAYS=7
#EVENT_PRUNE_NO_MOTION_DAYS=0
#EVENT_PRUNE_LOITERING_DAYS=7
#EVENT_PRUNE_SUPPRESSED_DAYS=1
#EVENT_PRUNE_COOLDOWN_DAYS=1
#EVENT_PRUNE_DEFAULT_DAYS=7
#EVENT_PRUNE_MAX_AGE_DAYS=3