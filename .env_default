# === Tucuxi — Configuração padrão ===
# Copie para .env e preencha os valores sensíveis.
# cp .env_default .env

# ── Servidor ──
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ── Detector (YOLO) ──
DETECTOR_MODEL_PATH=/app/data/models/detector.onnx
DETECTOR_CONFIDENCE=0.40
DETECTOR_IOU=0.45

# ── Motion detection ──
MOTION_MIN_AREA=8000
MOTION_PERSIST_FRAMES=3
RAIN_SPATIAL_RATIO=0.35
FRAME_WAIT_SECONDS=0.1

# ── Telegram ──
TELEGRAM_BOT_TOKEN=SEU_TOKEN_AQUI
TELEGRAM_CHAT_ID=SEU_CHAT_ID_AQUI

# ── MQTT / Home Assistant ──
MQTT_BROKER_URL=192.168.1.12
MQTT_BROKER_PORT=1883
MQTT_USERNAME=SEU_USERNAME_AQUI
MQTT_PASSWORD=SUA_SENHA_AQUI
MQTT_TOPIC=homeassistant/security/alert
HOME_ASSISTANT_URL=http://192.168.1.12:8123
HOME_ASSISTANT_TOKEN=SEU_TOKEN_HA_AQUI
HOME_ASSISTANT_EVENT_TYPE=security_alert

# ── Retenção de eventos ──
EVENT_PRUNE_INTERVAL_SECONDS=30
EVENT_LIST_LIMIT=50
#EVENT_PRUNE_MOTION_DETECTED_DAYS=1
#EVENT_PRUNE_CAPTURE_DAYS=7
#EVENT_PRUNE_SNAPSHOT_INFO_DAYS=7
#EVENT_PRUNE_NO_MOTION_DAYS=0
#EVENT_PRUNE_LOITERING_DAYS=7
#EVENT_PRUNE_SUPPRESSED_DAYS=1
#EVENT_PRUNE_COOLDOWN_DAYS=1
#EVENT_PRUNE_DEFAULT_DAYS=7
#EVENT_PRUNE_MAX_AGE_DAYS=3

# ── Predictor MVP ──
PREDICTOR_ENABLED=true
