# === Tucuxi — Configuração padrão ===
# Copie para .env e preencha os valores sensíveis.
# cp .env_default .env

# ── Predictor MVP ──
PREDICTOR_ENABLED=true
PREDICTOR_HISTORY_DAYS=7
PREDICTOR_INTERVAL_SECONDS=900
PREDICTION_THRESHOLD=0.75
PREDICTOR_DETER_COOLDOWN_SEC=900
PREDICTOR_ENTITY_MAP=

# ── Servidor ──
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ── Detector (YOLO) ──
DETECTOR_MODEL_PATH=/app/data/models/detector.onnx
DETECTOR_CONFIDENCE=0.30
DETECTOR_IOU=0.35

# ── Motion detection ──
MOTION_MIN_AREA=6000
MOTION_PERSIST_FRAMES=3
RAIN_SPATIAL_RATIO=0.35
FRAME_WAIT_SECONDS=0.1
# Tempo sem frame válido para considerar a câmera não-saudável (segundos)
WORKER_HEALTHY_TIMEOUT=15

# ── Telegram ──
TELEGRAM_BOT_TOKEN=SEU_TOKEN_AQUI
TELEGRAM_CHAT_ID=SEU_CHAT_ID_AQUI

# ── MQTT / Home Assistant ──
MQTT_BROKER_URL=192.168.1.12
MQTT_BROKER_PORT=1883
MQTT_USERNAME=SEU_USERNAME_AQUI
MQTT_PASSWORD=SUA_SENHA_AQUI
MQTT_TOPIC=homeassistant/security/alert
HOME_ASSISTANT_URL=http://192.168.1.12:8123
HOME_ASSISTANT_TOKEN=SEU_TOKEN_HA_AQUI
HOME_ASSISTANT_EVENT_TYPE=security_alert

# ── Sirene / atuação externa ──
SIREN_MQTT_TOPIC=secur/automation/siren
SIREN_EVENT_TYPES=intruder_detected,fall_detected,loitering,direction_change,unknown_detected

# ── Alertas / cooldowns ──
NO_MOTION_ALERT_SECONDS=60
ALERT_COOLDOWN_SECONDS=60
ALERT_COOLDOWN_INTRUDER=30
ALERT_COOLDOWN_UNKNOWN=30
ALERT_COOLDOWN_LOITERING=300
ALERT_COOLDOWN_DIRECTION=60
ALERT_COOLDOWN_FALL=30

# ── Tracking / comportamento ──
TRACK_IOU_THRESHOLD=0.3
TRACK_MAX_AGE_SECONDS=2.0
LOITERING_SECONDS=30
LOITERING_MAX_DISTANCE=80
FALL_ASPECT_RATIO=1.2

# ── Thumbnails ──
THUMBNAIL_INTERVAL_SECONDS=20
THUMBNAIL_DIFF_THRESHOLD=3.0
THUMBNAIL_HISTORY_SIZE=30
EVENT_DEDUP_WINDOW_SECONDS=300

# ── Clips ──
CLIP_PRE_SECONDS=10
CLIP_POST_SECONDS=10
CLIP_FPS=5
CLIP_HISTORY_SIZE=20

# ── Identity ──
IDENTITY_ENABLED=false
IDENTITY_FACE_MODEL_PATH=
IDENTITY_REID_MODEL_PATH=
IDENTITY_MATCH_THRESHOLD=0.6

# ── Privacidade ──
PRIVACY_MODE=false

# ── Auth / Sessão ──
SESSION_TTL_HOURS=24
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=5

# ── Retenção de eventos ──
EVENT_PRUNE_ENABLED=true
EVENT_PRUNE_INTERVAL_SECONDS=30
EVENT_LIST_LIMIT=50
#EVENT_PRUNE_MOTION_DETECTED_DAYS=1
#EVENT_PRUNE_CAPTURE_DAYS=7
#EVENT_PRUNE_SNAPSHOT_INFO_DAYS=7
#EVENT_PRUNE_NO_MOTION_DAYS=0
#EVENT_PRUNE_LOITERING_DAYS=7
#EVENT_PRUNE_SUPPRESSED_DAYS=1
#EVENT_PRUNE_COOLDOWN_DAYS=1
#EVENT_PRUNE_DEFAULT_DAYS=7
#EVENT_PRUNE_MAX_AGE_DAYS=3

